generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  COMPLETED
  CANCELLED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Vehicle {
  id          String  @id @default(cuid())
  name        String
  category    String // Sedan, SUV, Premium SUV, Tempo, Bus
  seats       Int
  perKm       Int // INR per km (outstation)
  hourly8     Int // 8hr/80km local package
  imageUrl    String?
  active      Boolean @default(true)
  bookings    Booking[]
}

model Package {
  id        String  @id @default(cuid())
  title     String
  summary   String
  imageUrl  String?
  priceFrom Int
  active    Boolean @default(true)
}

model Booking {
  id          String        @id @default(cuid())
  ref         String        @unique
  name        String
  phone       String // E.164 digits e.g. 919876543210
  tripType    String // OUTSTATION | AIRPORT | LOCAL | CORPORATE | PACKAGE
  pickup      String
  drop        String?
  pickupAt    DateTime
  passengers  Int           @default(1)
  vehicleId   String?
  vehicle     Vehicle?      @relation(fields: [vehicleId], references: [id])
  quote       Int?
  notes       String?
  status      BookingStatus @default(PENDING)
  driverName  String?
  driverPhone String?
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  createdAt   DateTime      @default(now())
  messages    MessageLog[]

  @@index([pickupAt])
  @@index([status])
}

model MessageLog {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind      String // CONFIRMATION | REMINDER | DRIVER
  ok        Boolean
  response  String?
  createdAt DateTime @default(now())
}

model Review {
  id      String  @id @default(cuid())
  name    String
  rating  Int
  text    String
  visible Boolean @default(true)
}


