generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  NEW
  AWAITING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

model Admin {
  id               String    @id @default(cuid())
  googleId         String?   @unique
  email            String    @unique
  passwordHash     String
  resetTokenHash   String?
  resetExpires     DateTime?
  createdAt        DateTime  @default(now())
}

model Image {
  id   String @id @default(cuid())
  mime String
  data Bytes
  createdAt DateTime @default(now())
}

model Vehicle {
  id        String    @id @default(cuid())
  name      String
  category  String // Sedan, SUV, Tempo, Bus...
  seats     Int
  ac        Boolean   @default(true)
  specs     String? // luggage, features
  perKm     Int
  hourly8   Int       @default(0)
  extraKm   Int       @default(0) // extra charge per km beyond package
  waitingPerHr Int    @default(0)
  nightCharge Int     @default(0)
  imageUrl  String?
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  bookings  Booking[]
  routeFares RouteFare[]
}

model Driver {
  id       String    @id @default(cuid())
  name     String
  phone    String?
  active   Boolean   @default(true)
  bookings Booking[]
}

model Route {
  id       String      @id @default(cuid())
  from     String
  to       String
  distanceKm Int?
  note     String?
  active   Boolean     @default(true)
  fares    RouteFare[]
}

model RouteFare {
  id        String  @id @default(cuid())
  routeId   String
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fare      Int

  @@unique([routeId, vehicleId])
}

model Package {
  id          String  @id @default(cuid())
  title       String
  summary     String
  itinerary   String?
  duration    String?
  imageUrl    String?
  priceFrom   Int
  published   Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  notes     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id            String        @id @default(cuid())
  requestNo     Int           @default(autoincrement())
  bookingNo     Int?          @unique // set only on confirmation
  bookingId     String?       @unique // e.g. CB-0001, set only on confirmation
  status        BookingStatus @default(NEW)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  customerName  String
  phone         String // 91XXXXXXXXXX
  tripType      String
  pickup        String
  destination   String?
  pickupAt      DateTime
  passengers    Int           @default(1)
  vehicleId     String?
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])
  vehicleName   String? // snapshot
  driverId      String?
  driver        Driver?       @relation(fields: [driverId], references: [id])
  notes         String?
  // Agreed fare snapshot: never joined to live prices
  agreedFare    Int?
  confirmedAt   DateTime?
  ownerNotes    String?
  flagged       Boolean       @default(false)
  flagReason    String?
  ipHash        String?
  createdAt     DateTime      @default(now())
  payments      Payment[]
  messages      MessageLog[]

  @@index([status])
  @@index([pickupAt])
  @@index([phone])
}

model Payment {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount    Int
  mode      String // Cash, UPI, Bank, Card
  note      String?
  paidAt    DateTime @default(now())
}

// Records the owner manually marking a WhatsApp message as sent.
model MessageLog {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  template  String
  createdAt DateTime @default(now())
}

model MessageTemplate {
  key  String @id
  body String
}

model Setting {
  key   String @id
  value String
}

model Review {
  id      String  @id @default(cuid())
  name    String
  rating  Int
  text    String
  visible Boolean @default(true)
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String?
  googleId     String?   @unique
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

